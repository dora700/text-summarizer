    {
      "handler": "_h_tools_cancel_job",
      "method": "cancelJob",
      "namespace": "tools",
      "no_auth": false,
      "params_schema": {
        "additionalProperties": false,
        "properties": {
          "jobId": {
            "pattern": "^tjob_[0-9a-f]{32}$",
            "type": "string"
          },
          "reason": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "jobId"
        ],
        "type": "object"
      },
      "stub": false
    },
    {
      "handler": "_h_tools_get_job",
      "method": "getJob",
      "namespace": "tools",
      "no_auth": false,
      "params_schema": {
        "additionalProperties": false,
        "properties": {
          "jobId": {
            "pattern": "^tjob_[0-9a-f]{32}$",
            "type": "string"
          },
          "limit": {
            "default": 100,
            "maximum": 500,
            "minimum": 1,
            "type": "integer"
          },
          "sinceSeq": {
            "default": 0,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "jobId"
        ],
        "type": "object"
      },
      "stub": false
    },
    {
      "handler": "_h_tools_invoke",
      "method": "invoke",
      "namespace": "tools",
      "no_auth": false,
      "params_schema": {
        "additionalProperties": false,
        "properties": {
          "args": {
            "default": {},
            "type": "object"
          },
          "method": {
            "type": [
              "string",
              "null"
            ]
          },
          "timeoutMs": {
            "description": "Per-call timeout in milliseconds. Clamped to the host policy (default 65000, hard cap 90000 — bounded by the public edge's ~100 s held-request ceiling; see forum #199). On timeout the call resolves with HostRpcError(code='tool_timeout') whose details echo requested_timeout_ms/max_timeout_ms when the value was clamped down.",
            "maximum": 90000,
            "minimum": 1000,
            "type": "integer"
          },
          "tool_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "tool_id"
        ],
        "type": "object"
      },
      "stub": false
    },
    {
      "handler": "_h_tools_invoke_async",
      "method": "invokeAsync",
      "namespace": "tools",
      "no_auth": false,
      "params_schema": {
        "additionalProperties": false,
        "properties": {
          "args": {
            "default": {},
            "type": "object"
          },
          "clientTag": {
            "description": "Opaque caller correlation tag, stored verbatim on the job row and filterable via tools.listJobs — the reload-recovery handle.",
            "maxLength": 120,
            "type": "string"
          },
          "method": {
            "type": [
              "string",
              "null"
            ]
          },
          "timeoutMs": {
            "description": "Plugin-facing job deadline. Default 1800000 (30 min). Clamped server-side to [InvokeAsyncPolicy.min_ms, max_ms] (60 s – 24 h). The call itself returns immediately with a jobId; results arrive via the tool_job dashboard event + tools.getJob polling.",
            "maximum": 86400000,
            "minimum": 60000,
            "type": "integer"
          },
          "tool_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "tool_id"
        ],
        "type": "object"
      },
      "stub": false
    },
