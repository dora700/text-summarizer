    {
      "handler": "_h_tools_list_jobs",
      "method": "listJobs",
      "namespace": "tools",
      "no_auth": false,
      "params_schema": {
        "additionalProperties": false,
        "properties": {
          "clientTag": {
            "maxLength": 120,
            "type": "string"
          },
          "limit": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "since": {
            "format": "date-time",
            "type": "string"
          },
          "state": {
            "oneOf": [
              {
                "enum": [
                  "queued",
                  "running",
                  "succeeded",
                  "failed",
                  "cancelled",
                  "expired"
                ],
                "type": "string"
              },
              {
                "items": {
                  "enum": [
                    "queued",
                    "running",
                    "succeeded",
                    "failed",
                    "cancelled",
                    "expired"
                  ],
                  "type": "string"
                },
                "maxItems": 6,
                "minItems": 1,
                "type": "array"
              }
            ]
          },
          "tool_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      },
      "stub": false
