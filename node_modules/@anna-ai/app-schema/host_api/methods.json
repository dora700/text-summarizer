      "params_schema": {
        "additionalProperties": false,
        "properties": {
          "filename": {
            "description": "Save-as filename shown in the browser download dialog. Defaults to the last path segment. Baked into the presigned Content-Disposition: attachment header.",
            "type": [
              "string",
              "null"
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "scope": {
            "description": "Same semantics as files.download_url — cross-app reads need the aps.scope.app.read capability.",
            "type": [
              "string",
              "null"
            ]
          },
          "ttl_seconds": {
            "default": 300,
            "description": "Presigned URL lifetime (host consumes it immediately).",
            "maximum": 3600,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
